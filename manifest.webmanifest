{
  "name": "Folio Writing Studio",
  "short_name": "Folio",
  "description": "A writing studio for short stories, novellas and novels.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#e3e7ea",
  "theme_color": "#16645f",
  "categories": ["productivity", "books"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/folio.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/x-folio": [".folio"] }, "launch_type": "single-client" }
  ],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] }
}
